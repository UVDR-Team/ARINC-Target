# Optional initial cache for the offline target-only build.
# Copy this file, replace both paths, and run:
# cmake -S . -B build-vxworks -C /absolute/path/to/your-cache.cmake
# Use the DKM toolchain supplied by your board SDK.
# No prebuilt helper/TFTP/ARINC archives or compiled Boost libraries are needed.
set(CMAKE_TOOLCHAIN_FILE "/replace/with/sdk/dkm.toolchain.cmake" CACHE FILEPATH "SDK DKM toolchain")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY CACHE STRING "Cross compiler probe")
set(ARINC615A_BOOST_INCLUDE_DIR "/replace/with/sdk/include" CACHE PATH "Directory containing boost/version.hpp")
set(ARINC615A_TARGET_ONLY ON CACHE BOOL "Target-only source graph")
set(ARINC_615A_VXWORKS ON CACHE BOOL "DKM defaults")
set(ARINC615A_BACKGROUND_THREAD OFF CACHE BOOL "Run inside an application-owned task")
set(ARINC615A_BUILD_TESTS OFF CACHE BOOL "Native tests are not DKM sources")
set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration")
