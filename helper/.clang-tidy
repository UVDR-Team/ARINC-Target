---
Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  readability-*,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers,
  -llvmlibc-*
SystemHeaders: false
WarningsAsErrors: ''
HeaderFilterRegex: ''
FormatStyle: none
CheckOptions:
  readability-trailing-comma.MultiLineCommaPolicy: 'Ignore'
